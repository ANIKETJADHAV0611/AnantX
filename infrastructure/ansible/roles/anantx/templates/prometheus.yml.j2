global:
  scrape_interval: 5s

scrape_configs:

  - job_name: "prometheus"
    static_configs:
      - targets:
          - localhost:9090

  - job_name: "anantx-backend"
    metrics_path: /metrics
    static_configs:
      - targets:
          - backend:8000

  - job_name: "anantbuy"
    metrics_path: /metrics
    static_configs:
      - targets:
          - "{{ hostvars['anantbuy'].prometheus_target_ip }}:9000"